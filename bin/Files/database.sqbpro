den_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">DROP TABLE produtos;
                 
CREATE TABLE produtos (
pr_codigo INTEGER PRIMARY KEY,
pr_nome TEXT NOT NULL,
pr_un_palete INTEGER DEFAULT(0),
pr_estoque INTEGER DEFAULT(0),
ativo INTEGER DEFAULT(1)
);


DROP TABLE materia_prima;
                
CREATE TABLE materia_prima(
mp_codigo INTEGER PRIMARY KEY,
mp_nome TEXT NOT NULL,
mp_estoque INTEGER DEFAULT(0)
);

DROP TABLE materia_primalog

CREATE TABLE materia_primalog
(
id INTEGER PRIMARY KEY AUTOINCREMENT,
mp_codigolog INTEGER,
mp_estoquelog INTEGER,
data_atualizacao TEXT DEFAULT (datetime('now', 'localtime')),
FOREIGN KEY(mp_codigolog) REFERENCES materia_prima(mp_codigo)
);


DROP TABLE produto_materiaprima
				
CREATE TABLE produto_materiaprima (
pmp_pr_codigo INTEGER,
pmp_mp_codigo INTEGER,
pmp_qtd_fixa REAL,
pmp_qtd REAL,
FOREIGN KEY(pmp_pr_codigo) REFERENCES produtos(pr_codigo),
FOREIGN KEY(pmp_mp_codigo) REFERENCES materia_prima(mp_codigo)
);

DROP TABLE producao;

CREATE TABLE producao (
pd_codigo INTEGER PRIMARY KEY AUTOINCREMENT,
pd_pr_codigo INTEGER UNIQUE,
pd_data TEXT NOT NULL,
pd_qtd_produzida REAL,
FOREIGN KEY(pd_pr_codigo) REFERENCES produtos(pr_codigo)
);

DROP TABLE producao_log;

CREATE TABLE producao_log (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
	log_pd_codigo INTEGER,
    log_pd_data TEXT,
    log_pd_qtd REAL,
    data_atualizacao TEXT DEFAULT (datetime('now', 'localtime')),
	FOREIGN KEY(log_pd_codigo) REFERENCES produtos(pr_codigo)
);

SELECT * FROM produtos
SELECT * FROM producao
SELECT * FROM materia_primalog
SELECT * FROM producao_log
SELECT * FROM produto_materia_prima

INSERT INTO produto_materiaprima (pmp_pr_codigo, pmp_mp_codigo, pmp_qtd_fixa)
SELECT p.pr_codigo, mp.mp_codigo, 100
FROM Produtos p
JOIN materia_prima mp ON mp.mp_nome LIKE '%Areia Grossa%'
WHERE p.pr_nome LIKE '%BLOCO%';


