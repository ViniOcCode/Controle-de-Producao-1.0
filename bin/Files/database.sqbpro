SELECT log_pd_data, SUM(log_pd_qtd)
FROM producao_log
WHERE log_pd_data
BETWEEN '2024-09-23' AND '2024-10-23'
GROUP BY log_pd_data;

SELECT
	desc, Ddaata 
FROM
	produtos
	LEFT JOIN producao on producao.produto = produto.produto and @data = producao.dat
WHERE
	produtos.produto = @produto
	
	
SELECT 
	pl.log_pd_data, 
	SUM(log_pd_qtd) AS total_produzido 
FROM 
	producao_log pl 
LEFT JOIN 
	produtos pr ON pl.log_pd_codigo = pr.pr_codigo 
WHERE pr.pr_nome LIKE '%BLOCO%'
GROUP BY 
	pl.log_pd_data 
ORDER BY 
	pl.log_pd_data
	
--------------------

SELECT 
    pl.log_pd_data, 
    SUM(log_pd_qtd) AS total_produzido 
FROM 
    producao_log pl 
LEFT JOIN 
    produtos pr ON pl.log_pd_codigo = pr.pr_codigo 
WHERE 
    pr.pr_nome LIKE '%BLOCO%'
	
GROUP BY 
    pl.log_pd_data 
ORDER BY 
    STRFTIME('%Y-%m-%d', SUBSTR(pl.log_pd_data, 7, 4) || '-' || SUBSTR(pl.log_pd_data, 4, 2) || '-' || SUBSTR(pl.log_pd_data, 1, 2));

--------------------------
SELECT 
	pl.log_pd_data, 
	SUM(log_pd_qtd) AS total_produzido 
FROM 
	producao_log pl 
LEFT JOIN 
	produtos pr ON pl.log_pd_codigo = pr.pr_codigo 
	
WHERE pr.pr_nome LIKE '%BLOCO%'
AND STRFTIME('%m-%Y', SUBSTR(pl.log_pd_data, 7, 4) || '-' || SUBSTR(pl.log_pd_data, 4, 2) || '-' || SUBSTR(pl.log_pd_data, 1, 2)) = STRFTIME('%m-%Y', 'now')

GROUP BY 
	pl.log_pd_data 
ORDER BY 
	pl.log_pd_data;
	
-----------------

SELECT 
    pl.log_pd_data, 
    SUM(log_pd_qtd) AS total_produzido 
FROM 
    producao_log pl 
LEFT JOIN 
    produtos pr ON pl.log_pd_codigo = pr.pr_codigo 
WHERE 
    pr.pr_nome LIKE '%BLOCO%' 
    AND STRFTIME('%m-%Y', SUBSTR(pl.log_pd_data, 7, 4) || '-' || SUBSTR(pl.log_pd_data, 4, 2) || '-' || SUBSTR(pl.log_pd_data, 1, 2)) = STRFTIME('%m-%Y', 'now')
GROUP BY 
    pl.log_pd_data 
ORDER BY 
    STRFTIME('%Y-%m-%d', SUBSTR(pl.log_pd_data, 7, 4) || '-' || SUBSTR(pl.log_pd_data, 4, 2) || '-' || SUBSTR(pl.log_pd_data, 1, 2));
----------------------------------------------------------------------
SELECT 
    pl.log_pd_data, 
    SUM(log_pd_qtd) AS total_produzido,
    -- Alias para armazenar a data formatada como MM-YYYY (para o filtro)
    STRFTIME('%m-%Y', 
             SUBSTR(pl.log_pd_data, 7, 4) || '-' || 
             SUBSTR(pl.log_pd_data, 4, 2) || '-' || 
             SUBSTR(pl.log_pd_data, 1, 2)) AS data_formatada_mes_ano,
    -- Alias para armazenar a data formatada como YYYY-MM-DD (para ordenação)
    STRFTIME('%Y-%m-%d', 
             SUBSTR(pl.log_pd_data, 7, 4) || '-' || 
             SUBSTR(pl.log_pd_data, 4, 2) || '-' || 
             SUBSTR(pl.log_pd_data, 1, 2)) AS data_formatada_ano_mes_dia
FROM 
    producao_log pl
LEFT JOIN 
    produtos pr ON pl.log_pd_codigo = pr.pr_codigo
WHERE 
    pr.pr_nome LIKE '%BLOCO%'
    -- Filtrando pelo mês e ano atuais usando o alias 'data_formatada_mes_ano'
	AND data_formatada_mes_ano = STRFTIME('%m-%Y', 'now')
GROUP BY 
    pl.log_pd_data
-- Ordenando pelo alias 'data_formatada_ano_mes_dia'
ORDER BY 
	data_formatada_ano_mes_dia;
	
-----


select P.pr_nome, sum(producao_log.log_pd_qtd) as Q
from producao_log
inner join produtos P on P.pr_codigo = producao_log.log_pd_codigo
where log_pd_data between '10/10/2024' and '23/10/2024'
group by P.pr_nome
order by Q desc

SELECT 
pd_qtd_produzida,
pd_data
FROM 
	producao 
ORDER BY pd_qtd_produzida ASC;

	
LEFT JOIN -&gt; a tabela principal continua trazendo valores, a tabela de relação volta tudo null, caso não exista relação ou retorna os valores relacionados

